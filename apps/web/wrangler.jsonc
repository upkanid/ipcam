{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ipcam-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": false,
  "workers_dev": true,
  "preview_urls": true,
  "secrets": {
    "required": ["TURN_KEY_ID", "TURN_KEY_API_TOKEN"]
  },
  "routes": [
    {
      "pattern": "ipcam.upkan.id",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNALING_ROOMS",
        "class_name": "SignalingRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SignalingRoom"]
    }
  ]
}
